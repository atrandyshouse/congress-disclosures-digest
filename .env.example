# Copy to .env for LOCAL testing only. Never commit a real .env --
# in production these are GitHub Actions secrets instead (see README).
#
# Quick start once this is filled in:
#   python scripts/fetch_and_email.py --doctor    # check everything, send nothing
#   python scripts/fetch_and_email.py --force --dry-run   # write digest-preview.html
#   python scripts/fetch_and_email.py --force     # actually email it

# --- Credentials -----------------------------------------------------------
# Optional. Without it the digest falls back to the free House Clerk feed,
# which lists who filed and links the PDF but has no ticker/amount detail.
FMP_API_KEY=your_fmp_api_key

# Required to actually send mail.
RESEND_API_KEY=your_resend_api_key
RECIPIENT_EMAIL=you@example.com

# Leave as-is unless you have verified your own domain in Resend. With an
# unverified sender, Resend only delivers to the address on your Resend account.
FROM_EMAIL=onboarding@resend.dev

# --- Digest content --------------------------------------------------------
LOOKBACK_DAYS=3          # how far back to look for newly-filed disclosures
INCLUDE_SENATE=true      # also pull senate-latest from FMP
MIN_AMOUNT=0             # drop trades whose bracket midpoint is below this
HIGHLIGHT_AMOUNT=50000   # highlight rows at or above this midpoint
SEND_WHEN_EMPTY=false    # email even on days with nothing new?

# --- Scheduling ------------------------------------------------------------
SEND_HOUR_CT=7           # target send hour, US Central
LATE_GRACE_HOURS=3       # still send if GitHub's cron runs late

# --- Local testing ---------------------------------------------------------
# The CLI flags (--force / --dry-run / --debug / --doctor) are equivalent.
FORCE_RUN=false
DRY_RUN=false
DEBUG_DUMP=false
